# Copy to .env.<mode>.local and supply environment-specific public settings.
VITE_TRAVELIAN_API_BASE_URL=
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# travelian-api-gateway origin (without /v1). Admin Dashboard reads from it.
VITE_TRAVELIAN_GATEWAY_BASE_URL=
# Public site origin for links, sitemap and structured data. Optional; default https://travelian.pk.
VITE_SITE_URL=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn analytics off.
VITE_GA_MEASUREMENT_ID=
